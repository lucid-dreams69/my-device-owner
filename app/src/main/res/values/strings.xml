<resources>
    <string name="app_name">My Device Owner</string>

    <string name="status_owner">✅ Device owner: active</string>
    <string name="status_owner_detail">This app manages the phone. The policies below take effect immediately and can be switched off again.</string>
    <string name="status_not_owner">⚪ Not device owner</string>
    <string name="status_not_owner_detail">To enroll: factory reset, tap the first welcome screen 6 times and scan the QR code.\n\nFor testing without a reset (all accounts removed first):\nadb shell dpm set-device-owner %1$s</string>

    <string name="section_device">Device</string>
    <!-- Quoted so the alignment spaces survive. -->
    <string name="info_format">"Model:          %1$s\nAndroid:        %2$s (API %3$d)\nSecurity patch: %4$s\nApp version:    %5$s\nAdmin:          %6$s"</string>

    <string name="section_log">Enrollment log</string>
    <string name="log_empty">No enrollment events recorded yet.</string>


    <string name="lock_info_save">Save lock screen message</string>
    <string name="lock_info_saved">Lock screen message saved</string>
    <string name="lock_now">Lock screen now</string>

    <string name="section_remove">Leave device-owner mode</string>
    <string name="remove_owner_explain">Clears the policies above and turns this into a normal app that you can uninstall. No factory reset needed.</string>
    <string name="remove_owner">Remove device owner</string>
    <string name="remove_owner_title">Remove device owner?</string>
    <string name="remove_owner_message">The phone stops being managed. To make this app device owner again you need another factory reset and QR enrollment (or the adb command).</string>
    <string name="remove_owner_confirm">Remove</string>
    <string name="remove_owner_done">Device owner removed. You can uninstall the app normally now.</string>
